# Copie para .env.local e preencha os valores.
# Nunca commite .env.local — ele contém segredos.

# Supabase (mesmos valores do painel do projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOMENTE servidor: nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação, sem barra no final.
# Local: http://localhost:3000
# Produção: https://SEU-PROJETO.vercel.app (ou seu domínio customizado)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alternativa somente servidor: se NEXT_PUBLIC_SITE_URL não estiver definida,
# NEXT_SITE_URL também é aceita. Na Vercel, VERCEL_URL é usada como fallback.
NEXT_SITE_URL=

# SOMENTE servidor: texto aleatório longo e estável usado no hash de IP.
IP_HASH_SALT=
